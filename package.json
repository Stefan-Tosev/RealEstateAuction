{
  "name": "realestateauction",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "next build && playwright test --config=playwright.prod.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "sharp": "0.34.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "dotenv": "16.4.7",
    "prisma": "6.19.3",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
