# Copy to .env and fill in.

# Local Postgres — matches docker-compose.yml.
DATABASE_URL="postgresql://auctionhouse:auctionhouse@localhost:5432/auctionhouse"

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=""

# Canonical origin, no trailing slash. Auth.js derives its callback URLs
# from this; leave it unset and it falls back to trusting the request's
# Host header. Required in every deployed environment.
AUTH_URL="http://localhost:3000"

# Public site origin, used for canonical/hreflang tags and the sitemap.
# Wrong value here means wrong URLs in Google's index.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seeded once by `npm run db:seed`. Not used after the first admin exists.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Shared secret for /api/internal/close-lots. The closing worker sends it
# as a bearer token. Unset means the endpoint refuses everything, which
# is deliberate — an exposed endpoint that closes auctions is worse than
# lots that visibly stop closing.
CRON_SECRET=""

# Resend, for outbound email. Without a key every message is queued and
# logged instead of delivered — see src/server/notifications/transport.ts.
# The key is checked rather than NODE_ENV so a production box with no key
# cannot silently start mailing, and a developer with one can test for real.
RESEND_API_KEY=""

# The From address. Resend refuses any domain not verified in the account,
# which is the usual reason a first send comes back 422. Their shared
# sandbox sender works for testing without a domain:
#   Auction House <onboarding@resend.dev>
MAIL_FROM="Auction House <onboarding@resend.dev>"

# Claude, for drafting bilingual listing copy in the admin. Unset means
# the drafter is offered but disabled, and descriptions are written by
# hand — see src/server/copy/draft.ts.
ANTHROPIC_API_KEY=""
# Sonnet by default: short prose from structured facts, where the quality
# difference against Opus does not show and the cost difference does.
COPY_MODEL="claude-sonnet-5"

# The auction house's own registration, printed on every invoice. Without
# these no invoice can be raised at all — a document missing the issuer's
# ЕИК is not a defective invoice, it is not an invoice, and one already
# sent cannot be unsent. VAT is optional: a business below the
# registration threshold has no number and charges none.
INVOICE_ISSUER_NAME=""
INVOICE_ISSUER_EIK=""
INVOICE_ISSUER_VAT=""
INVOICE_ISSUER_ADDRESS=""
INVOICE_ISSUER_IBAN=""

# Demo invoicing: placeholder issuer details, every document marked
# SPECIMEN, and a separate DEMO- numbering series so switching to real
# details still starts real numbering at 1.
#
# The placeholder ЕИК deliberately fails its own checksum, so it cannot
# collide with a real registered company. Never set this to false without
# filling in the four fields above.
INVOICE_DEMO_MODE="false"
